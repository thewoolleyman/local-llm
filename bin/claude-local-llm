#!/bin/bash
# Runs Claude Code against the local fleet router (over Tailscale). The
# Anthropic Messages transport is provided natively by llama.cpp/llama-swap;
# Claude Code's normal agent loop, tools, MCP, and model picker remain in use.
#
# Override router location/key with LOCAL_LLM_ROUTER_HOST,
# LOCAL_LLM_ROUTER_PORT, LOCAL_LLM_ROUTER_API_KEY, or
# LOCAL_LLM_ROUTER_API_KEY_FILE. Override the initial local model with
# CLAUDE_LOCAL_MODEL or CLAUDE_LOCAL_SMALL_FAST_MODEL.
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
# This wrapper ends in `exec`, which REPLACES this process image -- so the
# wrapper leaves no trace in the launched agent's parent chain, and a
# supervisor that wants to relaunch the session through the same wrapper
# cannot discover it by walking parents. The environment DOES survive exec,
# so publish the wrapper's own resolved path there as the durable record.
# Read by livespec-overseer's launch-profile capture; harmless otherwise.
export LIVESPEC_LOCAL_LLM_WRAPPER="$SCRIPT_DIR/${SOURCE_PATH##*/}"
# shellcheck source=bin/lib/local-llm-common.sh
source "$SCRIPT_DIR/lib/local-llm-common.sh"

if ! command -v claude >/dev/null 2>&1; then
  echo "error: claude is not installed / not on PATH" >&2
  exit 1
fi

: "${CLAUDE_LOCAL_MODEL:=macmini/qwen3-coder-next}"
: "${CLAUDE_LOCAL_SMALL_FAST_MODEL:=$CLAUDE_LOCAL_MODEL}"
# Claude Code's gateway discovery only admits model IDs containing "claude"/
# "anthropic", so the fleet's qwen3 IDs are filtered out of auto-discovery.
# Pin each fleet peer to a built-in alias instead so all three appear in the
# native /model picker: Opus -> M4 Max, Sonnet -> GMKtec, and the main model +
# custom entry below -> Mac mini. (The Haiku alias stays the small/fast model.)
: "${ANTHROPIC_DEFAULT_OPUS_MODEL:=m4max/qwen3-coder-next}"
: "${ANTHROPIC_DEFAULT_OPUS_MODEL_NAME:=Local LLM (M4 Max)}"
: "${ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION:=Local model via M4 Max fleet router}"
: "${ANTHROPIC_DEFAULT_SONNET_MODEL:=gmktec/qwen3-coder-next}"
: "${ANTHROPIC_DEFAULT_SONNET_MODEL_NAME:=Local LLM (GMKtec EVO-X2)}"
: "${ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION:=Local model via GMKtec fleet router}"

local_llm_require_router_key
local_llm_check_router_reachable

# Claude Code appends /v1/messages itself. The shared helper returns the
# OpenAI-compatible /v1 base used by Codex and Pi, so remove that suffix here
# rather than making Claude request /v1/v1/messages.
export ANTHROPIC_BASE_URL="http://${LOCAL_LLM_ROUTER_HOST}:${LOCAL_LLM_ROUTER_PORT}"
export ANTHROPIC_AUTH_TOKEN="$LOCAL_LLM_ROUTER_API_KEY"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-$CLAUDE_LOCAL_MODEL}"
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-$CLAUDE_LOCAL_SMALL_FAST_MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL_NAME ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION
export ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL_NAME ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION
# Claude Code 2.1.129+ requires this opt-in before it discovers gateway
# models from /v1/models for the native /model picker.
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="${CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY:-1}"
# The local servers advertise 32K (mini), 32K (GMKtec), and 65K (M4 Max), not
# Claude's 1M context. Disable Claude Code's extended-context request mode or it
# will send a 51,200-token request to a 32K peer and llama.cpp will reject it.
export CLAUDE_CODE_DISABLE_1M_CONTEXT="${CLAUDE_CODE_DISABLE_1M_CONTEXT:-1}"
# The gateway model ID is intentionally unrecognized by Claude Code, whose
# fallback assumption is larger than the llama.cpp mini context. Declare the
# actual server limit so the request budget is never 51,200 tokens.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-32768}"
# Keep one explicit custom entry for clients where gateway discovery is absent
# or filtered; do not manufacture one entry per Anthropic alias.
export ANTHROPIC_CUSTOM_MODEL_OPTION="${ANTHROPIC_CUSTOM_MODEL_OPTION:-$CLAUDE_LOCAL_MODEL}"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="${ANTHROPIC_CUSTOM_MODEL_OPTION_NAME:-Local LLM ($CLAUDE_LOCAL_MODEL)}"
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="${ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION:-Local model via macmini fleet router}"

# Do not let a normal Claude.ai/API or cloud-provider credential route this
# process away from the local router. Keep nonessential network traffic local.
unset ANTHROPIC_API_KEY
unset ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_VERTEX_BASE_URL
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"

# Use Claude Code's no-keychain startup path for the local wrapper. The normal
# Claude Code startup reads "Claude Code-credentials" from the login keychain
# before the local router session is established; --bare prevents that, while
# --mcp-config explicitly keeps the user's MCP servers available.
claude_settings_json='{"apiKeyHelper":"'"$SCRIPT_DIR"'/claude-local-llm-api-key-helper"}'
claude_mcp_config="${CLAUDE_LOCAL_LLM_MCP_CONFIG:-$HOME/.claude.json}"

# `claude -p` can outlive or orphan MCP descendants when its output consumer
# exits early. Keep MCP available for normal interactive sessions, but make
# print-mode local tests use an explicit empty MCP configuration. Set
# CLAUDE_LOCAL_LLM_DISABLE_MCP=0 to opt out.
disable_mcp="${CLAUDE_LOCAL_LLM_DISABLE_MCP:-}"
if [ -z "$disable_mcp" ]; then
	for arg in "$@"; do
		if [ "$arg" = "-p" ] || [ "$arg" = "--print" ]; then
			disable_mcp=1
			break
		fi
	done
fi

if [ "$disable_mcp" = "1" ]; then
	exec claude --bare --settings "$claude_settings_json" \
		--strict-mcp-config --mcp-config '{"mcpServers":{}}' "$@"
fi

if [ -f "$claude_mcp_config" ]; then
	exec claude --bare --settings "$claude_settings_json" \
		--mcp-config "$claude_mcp_config" "$@"
fi

exec claude --bare --settings "$claude_settings_json" "$@"
