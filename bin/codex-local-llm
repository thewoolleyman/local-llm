#!/bin/bash
# Runs `codex` against the local fleet router (over Tailscale). The router
# provider is selected for this process, while Codex's normal model picker
# remains in charge of model selection. See ../SPECIFICATION.md.
#
# Override router location/key with LOCAL_LLM_ROUTER_HOST,
# LOCAL_LLM_ROUTER_PORT, LOCAL_LLM_ROUTER_API_KEY, or
# LOCAL_LLM_ROUTER_API_KEY_FILE.
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
# shellcheck source=bin/lib/local-llm-common.sh
source "$SCRIPT_DIR/lib/local-llm-common.sh"

if ! command -v codex >/dev/null 2>&1; then
  echo "error: codex is not installed / not on PATH" >&2
  exit 1
fi

local_llm_require_router_key
local_llm_check_router_reachable

# The normal ~/.codex config already contains the fleet provider and merged
# catalog. This process-only override selects that provider without changing
# the user's normal frontier-provider default or inventing model-selection
# state. /model can therefore select any model exposed by the fleet.
exec codex -c model_provider=local-llm-fleet "$@"
