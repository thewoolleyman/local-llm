#!/bin/bash
# Runs `codex` pointed at the local model server on macbook-m4-max (over
# Tailscale) instead of a real OpenAI account. Does not touch the normal
# ~/.codex config — uses an isolated CODEX_HOME so a plain `codex` invocation
# elsewhere is unaffected. See ../SPECIFICATION.md.
#
# Override defaults via env vars: LOCAL_LLM_HOST, LOCAL_LLM_PORT,
# LOCAL_LLM_MODEL, LOCAL_LLM_API_KEY (or LOCAL_LLM_API_KEY_FILE).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/local-llm-common.sh
source "$SCRIPT_DIR/lib/local-llm-common.sh"

if ! command -v codex >/dev/null 2>&1; then
  echo "error: codex is not installed / not on PATH" >&2
  exit 1
fi

local_llm_require_api_key
local_llm_check_reachable

CODEX_HOME="$LOCAL_LLM_CONFIG_DIR/codex-home"
mkdir -p "$CODEX_HOME"

cat > "$CODEX_HOME/config.toml" <<EOF
model = "$LOCAL_LLM_MODEL"
model_provider = "local-llm"

[model_providers.local-llm]
name = "Local LLM ($LOCAL_LLM_HOST)"
base_url = "$(local_llm_base_url)"
env_key = "LOCAL_LLM_API_KEY"
wire_api = "responses"
EOF

export CODEX_HOME
exec codex "$@"
