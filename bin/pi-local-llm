#!/bin/bash
# Runs `pi` against the local fleet router (over Tailscale). It exposes all
# fleet models and leaves model selection to Pi's normal picker/cycling.
#
# Override router location/key with LOCAL_LLM_ROUTER_HOST,
# LOCAL_LLM_ROUTER_PORT, LOCAL_LLM_ROUTER_API_KEY, or
# LOCAL_LLM_ROUTER_API_KEY_FILE.
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
# shellcheck source=bin/lib/local-llm-common.sh
source "$SCRIPT_DIR/lib/local-llm-common.sh"

if ! command -v pi >/dev/null 2>&1; then
  echo "error: pi is not installed / not on PATH" >&2
  exit 1
fi

local_llm_require_router_key
local_llm_check_router_reachable

PI_CODING_AGENT_DIR="$LOCAL_LLM_CONFIG_DIR/pi-home"
mkdir -p "$PI_CODING_AGENT_DIR"

cat > "$PI_CODING_AGENT_DIR/models.json" <<EOF
{
  "providers": {
    "local-llm": {
      "baseUrl": "$(local_llm_router_base_url)",
      "api": "openai-completions",
      "apiKey": "\$LOCAL_LLM_ROUTER_API_KEY",
      "models": [
        {
          "id": "macmini/qwen3-coder-next",
          "name": "Qwen3-Coder-Next (Mac mini)",
          "contextWindow": 32768,
          "maxTokens": 8192
        },
        {
          "id": "m4max/qwen3-coder-next",
          "name": "Qwen3-Coder-Next (M4 Max)",
          "contextWindow": 65536,
          "maxTokens": 8192
        }
      ]
    }
  }
}
EOF

export PI_CODING_AGENT_DIR
exec pi --provider local-llm "$@"
