#!/bin/bash
# Runs `pi` pointed at the local model server on macbook-m4-max (over
# Tailscale) instead of a real provider account. Does not touch the normal
# ~/.pi/agent config — uses an isolated PI_CODING_AGENT_DIR so a plain `pi`
# invocation elsewhere is unaffected. See ../SPECIFICATION.md.
#
# Override defaults via env vars: LOCAL_LLM_HOST, LOCAL_LLM_PORT,
# LOCAL_LLM_MODEL, LOCAL_LLM_API_KEY (or LOCAL_LLM_API_KEY_FILE).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/local-llm-common.sh
source "$SCRIPT_DIR/lib/local-llm-common.sh"

if ! command -v pi >/dev/null 2>&1; then
  echo "error: pi is not installed / not on PATH" >&2
  exit 1
fi

local_llm_require_api_key
local_llm_check_reachable

PI_CODING_AGENT_DIR="$LOCAL_LLM_CONFIG_DIR/pi-home"
mkdir -p "$PI_CODING_AGENT_DIR"

cat > "$PI_CODING_AGENT_DIR/models.json" <<EOF
{
  "providers": {
    "local-llm": {
      "baseUrl": "$(local_llm_base_url)",
      "api": "openai-completions",
      "apiKey": "\$LOCAL_LLM_API_KEY",
      "models": [
        {
          "id": "$LOCAL_LLM_MODEL",
          "name": "Local LLM ($LOCAL_LLM_HOST)",
          "contextWindow": 65536,
          "maxTokens": 8192
        }
      ]
    }
  }
}
EOF

export PI_CODING_AGENT_DIR
exec pi --model "local-llm/$LOCAL_LLM_MODEL" "$@"
