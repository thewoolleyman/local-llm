#!/bin/bash
# Full Claude Code harness, backed by an Anthropic-to-OpenAI gateway.
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in /*) ;; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
export LIVESPEC_LOCAL_LLM_WRAPPER="$SCRIPT_DIR/${SOURCE_PATH##*/}"

secrets_file="${CLAUDE_OPENAI_SECRETS_FILE:-${CLAUDE_OPENAI_CONFIG_DIR:-$HOME/.config/local-llm/openai}/secrets.env}"
if [ -f "$secrets_file" ]; then
  # Private, user-owned shell environment file, never committed.
  source "$secrets_file"
fi
: "${CLAUDE_OPENAI_GATEWAY_KEY:?Run bin/configure-claude-openai.py first}"
export CLAUDE_OPENAI_GATEWAY_KEY
# Model availability, defaults and context come from Codex and fleet discovery.
# The launcher supplies session-only picker settings and preserves full startup.
exec python3 "$SCRIPT_DIR/claude-model-picker.py" "$@"
